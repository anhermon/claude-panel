# dependencies
node_modules/

# generated by the Claude Code engine when the mod loads (type stubs for tsc / editors); not source
.claude-plugin/types/

# eval run outputs; the case definitions and graders (evals/*/) ship
evals/results/

# runtime state and scratch folders (the panel itself writes under $TMPDIR/claude-panel, not here)
live/
tmp/
.tmp/
*.log

# OS / editor
.DS_Store

# the author's own dev workflow (copies this mod into other sessions' plugin development folders); not part of the plugin
scripts/sync-sessions.sh
